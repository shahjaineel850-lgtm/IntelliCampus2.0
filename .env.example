# ===========================================================================
# Academic Intelligence (Aurora Classroom) — Environment Configuration
# ===========================================================================

# Backend Configuration
PROJECT_NAME="Aurora Classroom API"
API_V1_STR="/api/v1"
SECRET_KEY="super_secret_jwt_key_for_development_prototype_change_in_production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database URLs
# Local SQLite default:
DATABASE_URL="sqlite+aiosqlite:///./auroraclassroom.db"
SYNC_DATABASE_URL="sqlite:///./auroraclassroom.db"

# Or Local PostgreSQL (with Docker Compose):
# DATABASE_URL="postgresql+asyncpg://aurora:aurorasecret@localhost:5432/auroraclassroom"
# SYNC_DATABASE_URL="postgresql://aurora:aurorasecret@localhost:5432/auroraclassroom"

# CORS Allowed Origins
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Frontend Configuration
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000/api/v1"
# Set to 'true' to demonstrate offline demo mode with seeded local scenario:
NEXT_PUBLIC_DEMO_MODE="false"
