# ===========================================================================
# IntelliCampus 2.0 — Production Environment Configuration
# ===========================================================================
# ⚠️  DO NOT commit this file to version control
# ⚠️  Use this as a template for your hosting platform's environment variables

# Backend Configuration
PROJECT_NAME="Aurora Classroom API"
API_V1_STR="/api/v1"

# ⚠️  CHANGE THIS IN PRODUCTION - Use a strong, random 32+ character string
SECRET_KEY="your-super-secret-key-change-this-to-random-secure-value"

# Token expiration (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===========================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# ===========================================================================
# Update these with your actual database connection details
DATABASE_URL="postgresql://aurora:your_password@host:5432/auroraclassroom"
SYNC_DATABASE_URL="postgresql://aurora:your_password@host:5432/auroraclassroom"

# ===========================================================================
# CORS Allowed Origins
# ===========================================================================
# Update with your actual production domain
BACKEND_CORS_ORIGINS=["https://intellicampus20.vercel.app","https://www.intellicampus20.vercel.app"]

# ===========================================================================
# Frontend Configuration
# ===========================================================================
NEXT_PUBLIC_API_BASE_URL="https://intellicampus20.vercel.app/api/v1"
NEXT_PUBLIC_DEMO_MODE="false"

# ===========================================================================
# Database Backup & Maintenance (Optional)
# ===========================================================================
# Enable automatic backups
DATABASE_BACKUP_ENABLED="true"
DATABASE_BACKUP_INTERVAL="daily"

# ===========================================================================
# Logging & Monitoring (Optional)
# ===========================================================================
LOG_LEVEL="INFO"
SENTRY_DSN=""  # Add Sentry DSN for error tracking

# ===========================================================================
# API Rate Limiting (Optional)
# ===========================================================================
RATE_LIMIT_ENABLED="true"
RATE_LIMIT_REQUESTS_PER_MINUTE=60
